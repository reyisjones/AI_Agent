{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "appName": {
      "value": "aiagent"
    },
    "location": {
      "value": "eastus"
    },
    "imageTag": {
      "value": "latest"
    },
    "openAiModel": {
      "value": "gpt-4o"
    },
    "allowedHttpDomains": {
      "value": "httpbin.org,jsonplaceholder.typicode.com,api.openai.com"
    },
    "openAiApiKey": {
      "reference": {
        "keyVault": {
          "id": "/subscriptions/<SUBSCRIPTION_ID>/resourceGroups/<RG>/providers/Microsoft.KeyVault/vaults/<KEYVAULT_NAME>"
        },
        "secretName": "openai-api-key"
      }
    }
  }
}
