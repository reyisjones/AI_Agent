# ────────────────────────────────────────────────────────────────────────────
# AI Agent — environment variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to source control.
# ────────────────────────────────────────────────────────────────────────────

# ── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.2

# ── Application ──────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO

# ── Redis (short-term memory) ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=3600

# ── Postgres (long-term memory) ──────────────────────────────────────────────
POSTGRES_DSN=postgresql+asyncpg://agent:agentpass@localhost:5432/agentdb

# ── Tool policy ───────────────────────────────────────────────────────────────
# Comma-separated list of allowed domains for the http_request tool
ALLOWED_HTTP_DOMAINS=httpbin.org,jsonplaceholder.typicode.com,api.openai.com
TOOL_TIMEOUT_SECONDS=10
TOOL_RATE_LIMIT_PER_MINUTE=30

# ── Knowledge base ────────────────────────────────────────────────────────────
DOCS_PATH=docs/

# ── Observability ─────────────────────────────────────────────────────────────
# Leave empty to use console exporter (dev mode)
OTLP_ENDPOINT=
SERVICE_NAME=ai-agent
SERVICE_VERSION=0.1.0

# ── Azure Key Vault (production) ─────────────────────────────────────────────
# In Container Apps, this is injected automatically via managed identity.
AZURE_KEYVAULT_URL=https://your-keyvault.vault.azure.net/
